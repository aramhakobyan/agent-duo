#!/usr/bin/env python3
"""Stand-in for `codex exec [resume <id>] --json -o <file> ... -` used by the
test suite. Rejects flags the real `exec resume` rejects, writes the last
message to the -o file and emits a JSONL thread event like the real CLI."""
import json
import os
import sys

argv = sys.argv[1:]
prompt = sys.stdin.read()
with open(os.environ["FAKE_LOG"], "a") as f:
    f.write(json.dumps({"agent": "codex", "argv": argv, "prompt": prompt}) + "\n")

if "resume" in argv and ("--color" in argv or "-s" in argv):
    print("error: unexpected argument found", file=sys.stderr)
    sys.exit(2)

out = argv[argv.index("-o") + 1]
verdict = os.environ.get("FAKE_CODEX_VERDICT", "AGREE")
with open(out, "w") as f:
    f.write(f"Codex verification.\n\n- ran check\n\nCONFIDENCE: 7\nVERDICT: {verdict}")

print(json.dumps({"type": "thread.started", "thread_id": "codex-thread-1"}))
print(json.dumps({"type": "turn.completed"}))
