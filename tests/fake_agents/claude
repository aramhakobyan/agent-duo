#!/usr/bin/env python3
"""Stand-in for `claude -p --output-format json` used by the test suite.

Logs each invocation to $FAKE_LOG and answers with $FAKE_CLAUDE_VERDICT
(AGREE by default). Final-report prompts get a plain report."""
import json
import os
import sys

prompt = sys.stdin.read()
argv = sys.argv[1:]
with open(os.environ["FAKE_LOG"], "a") as f:
    f.write(json.dumps({"agent": "claude", "argv": argv, "prompt": prompt}) + "\n")

if "REPORT" in prompt:
    result = "# Final report\n\n- Hypothesis validated by fake agents."
else:
    verdict = os.environ.get("FAKE_CLAUDE_VERDICT", "AGREE")
    result = f"Claude position.\n\n- point one\n\nCONFIDENCE: 8\nVERDICT: {verdict}"

print(json.dumps({"session_id": "claude-sess-1", "result": result, "is_error": False}))
